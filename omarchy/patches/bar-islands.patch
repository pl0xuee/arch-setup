+  // Which screens get a bar. Stock Omarchy puts one on every screen; listing
+  // names in shell.json as `bar.monitors` narrows it:
+  //
+  //   "bar": { "monitors": ["DP-1"] }
+  //
+  // Absent or empty means every screen, which is the stock behaviour. Names are
+  // the connector names Hyprland uses (`hyprctl monitors` — DP-1, HDMI-A-1).
+  readonly property var barScreens: {
+    var all = Quickshell.screens
+    var wanted = (barConfig && barConfig.monitors) ? barConfig.monitors : []
+    if (!wanted || wanted.length === 0) return all
+
+    var out = []
+    for (var i = 0; i < all.length; i++) {
+      if (wanted.indexOf(all[i].name) !== -1) out.push(all[i])
+    }
+    // A filter that matches nothing — a monitor unplugged, a name typo — would
+    // otherwise leave no bar on any screen, and no bar is also no way to get it
+    // back from the bar itself. Fall back to all screens instead.
+    return out.length > 0 ? out : all
+  }
